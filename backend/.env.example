# Application
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Database (PostgreSQL via psycopg v3)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lms_erp

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000

# Moodle Web Services (Sprint 7) — leave blank until a Moodle instance is available
# MOODLE_BASE_URL=https://moodle.example.com
# MOODLE_WSTOKEN=your_token
# MOODLE_TIMEOUT_SECONDS=30
# MOODLE_DEFAULT_CATEGORY_ID=1
# MOODLE_STUDENT_ROLE_ID=5
# Attendance sync additionally requires the Moodle Attendance plugin
# (mod_attendance) with its mod_attendance_* functions enabled on the
# external service that owns the token above.
